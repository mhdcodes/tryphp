---
type Props = {
  code: string;
};

const { code } = Astro.props;
---

<button
  type="button"
  class="copy-code inline-flex flex-none items-center gap-[5px] rounded-[5px] bg-ink px-[9px] py-[5px] font-sans text-xs font-semibold whitespace-nowrap text-page hover:opacity-85 data-copied:bg-good data-copied:opacity-100 motion-safe:transition"
  data-code={code}
>
  <svg
    width="13"
    height="13"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="9" y="9" width="13" height="13" rx="2"></rect>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
  </svg>
  <span class="label">Copy</span>
</button>

<script>
  // Delegated, and data-code is read on click, so a button whose command
  // changes after load (the command builder) copies the current command.
  let live: HTMLElement | undefined;

  function announce(text: string) {
    if (!live) {
      live = document.createElement("div");
      live.className = "sr-only";
      live.setAttribute("aria-live", "polite");
      document.body.append(live);
    }
    live.textContent = text;
  }

  const timers = new WeakMap<HTMLElement, number>();

  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLElement>(".copy-code");
    if (!button) return;

    navigator.clipboard
      .writeText(button.dataset.code ?? "")
      .then(() => {
        const label = button.querySelector(".label")!;
        button.dataset.copied = "";
        label.textContent = "Copied";
        announce("Command copied");

        clearTimeout(timers.get(button));
        timers.set(
          button,
          window.setTimeout(() => {
            delete button.dataset.copied;
            label.textContent = "Copy";
          }, 2000),
        );
      })
      .catch((err) => console.error("Error copying text: ", err));
  });
</script>
