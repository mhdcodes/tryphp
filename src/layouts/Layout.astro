---
import { Font } from "astro:assets";
import { Seo } from "astro-seo-meta";
import { Schema } from "astro-seo-schema";

import { site, versions } from "../config";
import "../styles/global.css";

const newest = versions[0]!.id;
const oldest = versions[versions.length - 1]!.id;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="msvalidate.01" content="D1916A06C360E731C64F4EEA9FE4BC08" />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <!-- Apply the theme before first paint: saved choice, else the system's. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        const dark = theme
          ? theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <Seo
      title={site.title}
      description={site.description}
      keywords={[
        "PHP environment setup",
        "Install PHP easily",
        "Set up PHP in seconds",
        "Effortless PHP configuration",
        "PHP setup for developers",
        "Quick PHP environment install",
        "PHP development environment",
        "Automatic PHP setup",
        "Install latest PHP version",
        "Easy PHP installation guide",
        "PHP environment for beginners",
        "Fast PHP setup tool",
      ]}
      facebook={{
        image: "/cover.png",
        url: site.url,
        type: "website",
      }}
      twitter={{
        image: "/cover.png",
        site: "@mhdcode",
        card: "summary",
      }}
    />

    <!-- JSON-LD structured data for better LLM understanding -->
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "TryPHP",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Linux",
        description: site.description,
        url: site.url,
        author: {
          "@type": "Organization",
          name: "TryPHP",
          url: site.url,
          logo: "https://tryphp.dev/cover.png",
          sameAs: ["https://github.com/mhdcodes"],
        },
        softwareVersion: `PHP ${oldest} - ${newest}`,
        keywords: "PHP installation, PHP environment setup, Linux PHP setup",
      }}
    />
  </head>
  <body class="bg-page font-sans leading-[1.55] text-ink antialiased">
    <slot />
  </body>
</html>
